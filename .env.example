# OpenAI 兼容 API 配置（复制为 .env 后填写）

# 方式 A：云端 API（默认）
API_KEY=sk-xxxxxxxx
BASE_URI=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 方式 B：本地小模型测试（Qwen2.5-0.5B-Instruct via llama.cpp，一键启动见 scripts/start-llama-qwen.ps1）
# 先把下面三行取消注释并覆盖方式 A：
# API_KEY=llama.cpp                       # 任意非空即可，本地 llama.cpp 不校验
# BASE_URI=http://127.0.0.1:8080/v1
# MODEL_NAME=qwen2.5-0.5b-instruct